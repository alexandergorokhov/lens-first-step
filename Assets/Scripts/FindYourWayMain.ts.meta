  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Find Your Way Inside – trip orchestrator</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input SceneObject camera {\"hint\":\"The device-tracked camera (the user's head)\"}"
    - "// @input SceneObject world {\"hint\":\"World anchor, placed at the user's start pose\"}"
    - '// @input SceneObject building {"hint":"Stand-in building root (child of World); sign node at its origin"}'
    - '// @input AssignableType_1 routeLine {"hint":"Floor line renderer"}'
    - '// @input AssignableType_2 standIn {"hint":"Stand-in building generator"}'
    - '// @input AssignableType_3 turnArrow {"hint":"Turn arrow at the lower edge of view"}'
    - '// @input AssignableType_4 modePanel {"hint":"Walk / Step-Free panel"}'
    - '// @input AssignableType_5 buildingUI {"hint":"Signs and pinch targets inside the building"}'
    - '// @input AssignableType_6 demoControls {"hint":"Demo controls panel"}'
    - '// @input AssignableType_7 hud {"hint":"Head-locked notice card + map badge"}'
    - '// @input AssignableType_8 arrivalCard {"hint":"Card over the destination"}'
    - '// @input Asset.InternetModule internetModule {"hint":"Internet module used to download the map"}'
    - '// @input Asset.AudioTrackAsset chime {"hint":"Chime played with the notice card"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input string mapKey = "airport" {"hint":"Which bundled map to start with (same list as src/core/data/index.json)", "widget":"combobox", "values":[{"label":"Airport (demo)", "value":"airport"}, {"label":"Hospital wing", "value":"hospital"}, {"label":"Campus (two buildings)", "value":"campus"}, {"label":"Preview room floor", "value":"room"}]}'
    - '// @input bool tryOnlineMap = true {"hint":"Try downloading the map (5 s timeout) before falling back to the built-in copy"}'
    - '// @input string mapBaseUrl = "http://localhost:8787/" {"hint":"Map server folder; each map downloads from here + its file name (map.json, hospital.json…). Local: http://localhost:8787/ (npm run maps). Once the repo is public: https://raw.githubusercontent.com/alexandergorokhov/lens-first-step/master/src/core/data/"}'
    - "// @input float eyeHeightCm = 180 {\"hint\":\"Standing eye height above the floor, cm — used when the floor can't be detected\", \"widget\":\"slider\", \"min\":100, \"max\":200, \"step\":1}"
    - "// @input vec3 signOffset = \"{0,0,-250}\" {\"hint\":\"Where the 'you are here' sign stands relative to the user when a mode is chosen (right, -, forward), cm\"}"
    - '// @input float lineAheadM = 10 {"hint":"How much of the route the line shows ahead of the user, m", "widget":"slider", "min":3, "max":30, "step":0.5}'
    - '// @input float halfViewDeg = 16 {"hint":"Half the horizontal field of view, degrees — outside it the turn arrow shows", "widget":"slider", "min":8, "max":40, "step":1}'
    - '// @input vec3 modePanelOffset = "{8,-4,-100}" {"hint":"Mode panel offset from the head at start (right, up, forward), cm"}'
    - '// @input vec3 demoOffset = "{-15,-14,-80}" {"hint":"Demo controls offset from the head (right, up, forward), cm — low-left, inside the ~32° view"}'
    - '// @ui {"widget":"group_end"}'
