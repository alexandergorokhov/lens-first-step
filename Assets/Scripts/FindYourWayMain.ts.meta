      {}
  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Find Your Way Inside – trip orchestrator</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - "// @input SceneObject camera {\"hint\":\"The device-tracked camera (the user's head)\"}"
    - "// @input SceneObject world {\"hint\":\"World anchor, placed at the user's start pose\"}"
    - '// @input SceneObject building {"hint":"Stand-in building root (child of World); sign node at its origin"}'
    - '// @input AssignableType_1 routeLine {"hint":"Floor line renderer"}'
    - '// @input AssignableType_2 standIn {"hint":"Stand-in building generator"}'
    - '// @input AssignableType_3 turnArrow {"hint":"Turn arrow at the lower edge of view"}'
    - '// @input AssignableType_4 modePanel {"hint":"Walk / Step-Free panel"}'
    - '// @input AssignableType_5 buildingUI {"hint":"Signs and pinch targets inside the building"}'
    - '// @input AssignableType_6 demoControls {"hint":"Demo controls panel"}'
    - '// @input AssignableType_7 hud {"hint":"Head-locked notice card + map badge"}'
    - '// @input AssignableType_8 arrivalCard {"hint":"Card over the destination"}'
    - '// @input Asset.InternetModule internetModule {"hint":"Internet module used to download the map"}'
    - '// @input Asset.AudioTrackAsset chime {"hint":"Chime played with the notice card"}'
    - "// @input Asset.AudioTrackAsset[] voiceClips {\"hint\":\"The companion's voice: Assets/Voice/<key>.wav, one per line in FindYourWaySpeech.ts (Kokoro af_heart)\"}"
    - '// @input bool companionSpeaks = true {"hint":"The companion speaks: short lines at the lift, at shops you like, a gate change and arrival (Voice: off in the Control panel)"}'
    - "// @input Asset.ObjectPrefab dogModel {\"hint\":\"The dog's animated model (Assets/Models/Dog, Quaternius CC0); empty: the jointed primitives\"}"
    - '// @input Asset.ObjectPrefab[] propModels {"hint":"Props that dress the airport and the mall (Assets/Models/Props, CC0), found by name"}'
    - '// @input Asset.ObjectPrefab agentModel {"hint":"The gate agent who talks to you (live captions, Assets/Models/People, CC0)"}'
    - '// @input Asset.ObjectPrefab assistantModel {"hint":"The shop assistant who talks to you (live captions, Assets/Models/People, CC0)"}'
    - "// @input Asset.ObjectPrefab robotModel {\"hint\":\"The robot's animated model (Assets/Models/Robot, Quaternius CC0); empty: the jointed primitives\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input string mapKey = "airport" {"hint":"Which bundled map to start with (same list as src/core/data/index.json)", "widget":"combobox", "values":[{"label":"Airport (demo)", "value":"airport"}, {"label":"Hospital wing", "value":"hospital"}, {"label":"Campus (two buildings)", "value":"campus"}, {"label":"Preview room floor", "value":"room"}, {"label":"Shopping mall (multi-stop)", "value":"mall"}]}'
    - '// @input bool tryOnlineMap = true {"hint":"Try downloading the map (5 s timeout) before falling back to the built-in copy"}'
    - '// @input string mapBaseUrl = "https://gist.githubusercontent.com/alexandergorokhov/ac59c2c8d02687651f256b320fff27b8/raw/" {"hint":"Map server folder; each map downloads from here + its file name (map.json, hospital.json…). Default: public gist copy of src/core/data. Local: http://localhost:8787/ (npm run maps, needs https in the preview)"}'
    - "// @input float eyeHeightCm = 180 {\"hint\":\"Standing eye height above the floor, cm — used when the floor can't be detected\", \"widget\":\"slider\", \"min\":100, \"max\":200, \"step\":1}"
    - '// @input bool startAtSign = true {"hint":"Lay the building out with you standing at the entrance sign, facing in (the line starts at your feet). Off: the old virtual sign at signOffset"}'
    - '// @input bool showDemoControls {"hint":"Show the demo controls (gate change, restart, map switch, play demo) — for recording; off for real use"}'
    - "// @input vec3 signOffset = \"{0,0,-250}\" {\"hint\":\"Where the 'you are here' sign stands relative to the user when a mode is chosen (right, -, forward), cm\"}"
    - '// @input float lineAheadM = 10 {"hint":"How much of the route the line shows ahead of the user, m", "widget":"slider", "min":3, "max":30, "step":0.5}'
    - '// @input float halfViewDeg = 16 {"hint":"Half the horizontal field of view, degrees — outside it the turn arrow shows", "widget":"slider", "min":8, "max":40, "step":1}'
    - '// @input vec3 modePanelOffset = "{8,-4,-100}" {"hint":"Mode panel offset from the head at start (right, up, forward), cm"}'
    - "// @input string companionModel = \"dog\" {\"hint\":\"The companion's model: same logic, only the look and the collectible change\", \"widget\":\"combobox\", \"values\":[{\"label\":\"Dog (treats)\", \"value\":\"dog\"}, {\"label\":\"Robot (bolts)\", \"value\":\"robot\"}]}"
    - '// @input bool companionOnAtStart {"hint":"Companion on when a trip starts (it can always be turned on or off on the app panel)"}'
    - '// @input bool showingPreset {"hint":"Showing preset (for the judges): overrides map, start at sign, demo controls, companion model and on at start; preselects Walk; adds Restart showing, Demo: gate change and an Airport/Preview room map switch to the Options panel"}'
    - '// @input string demo = "off" {"hint":"Demo preset: pick one and reset the preview; the Lens opens ready for that demo (clean screen, no demo controls, at the entrance sign). Off: the settings here", "widget":"combobox", "values":[{"label":"Off (settings below)", "value":"off"}, {"label":"1 Airport, wheelchair, Talk: gate 12C", "value":"airportWheelchair"}, {"label":"2 Mall, follow the dog, Talk: food court", "value":"mallPet"}, {"label":"3 Mall, Free walk with the robot", "value":"freeWalkRobot"}]}'
    - '// @input bool cleanScreen {"hint":"Clean screen while walking: only the floor line, the companion, the turn arrow and the offer boxes; no badges, hints, score, cards or demo controls; the arrival card for 3 s (on in the demo presets)"}'
    - '// @input bool liveCaptions {"hint":"Live captions: speech around you as two rows at the bottom, translated into the language below (ASR on Specs; the preview shows a scripted announcement). On in the demo presets"}'
    - '// @input string captionLanguage = "English" {"hint":"Live captions are translated into this language"}'
    - '// @input string presetPreferences = "coffee,clothes,hardware" {"hint":"The saved preferences of the demo (category ids, comma separated)"}'
    - '// @input float companionLeadM = 7 {"hint":"How far ahead the companion walks, m (core COMPANION_LEAD_M = 7). The floor only enters the view from about 5.4 m", "widget":"slider", "min":1.5, "max":10, "step":0.1}'
    - '// @input float pointSeconds = 3 {"hint":"Free walk: seconds the companion points at a matching shop", "widget":"slider", "min":1, "max":8, "step":0.5}'
    - '// @input float pointRadiusM = 12 {"hint":"Free walk: how near a matching shop must be for the companion to stop, m", "widget":"slider", "min":2, "max":15, "step":0.5}'
    - '// @input float maxStopsPerWalk {"hint":"Free walk: most stops per walk (0 = every match); stopping everywhere may get annoying", "widget":"slider", "min":0, "max":30, "step":1}'
    - '// @input float lookRangeM = 12 {"hint":"Free walk: how far a shop front can be looked at from, m", "widget":"slider", "min":3, "max":25, "step":0.5}'
    - '// @input vec3 offerOffset = "{24,0,-100}" {"hint":"The offer list, from the head (right, up, forward), cm"}'
    - '// @input string multiStops {"hint":"Multi-stop trip on maps that have these place ids (comma separated, ordered for the shortest walk); empty = off"}'
    - '// @input vec3 appPanelOffset = "{-30,-38,-55}" {"hint":"App panel offset from the head (right, up, forward), cm — waist height, to the left"}'
    - '// @input vec3 playPanelOffset = "{-34,-14,-55}" {"hint":"Where the app panel sits while playing Hop (cm from the head): to the side, clear of the lane"}'
    - '// @input vec3 demoOffset = "{-15,-14,-80}" {"hint":"Demo controls offset from the head (right, up, forward), cm — low-left, inside the ~32° view"}'
    - '// @ui {"widget":"group_end"}'
